# Condition B — version-MATCHED container.
# Every software component is pinned to the same version as the bare-metal host,
# so that B - A isolates the cost of containerisation itself.
#
# Host reference (from RUN_INFO.txt of the bare-metal runs):
#   Debian 13 (trixie), glibc 2.41, Python 3.13, onnxruntime 1.29.0
#
# Build:  docker build -f Dockerfile.matched -t infer:matched .
FROM python:3.13-slim-trixie

RUN apt-get update && apt-get install -y --no-install-recommends \
        libglib2.0-0 \
        procps \
    && rm -rf /var/lib/apt/lists/*

# PIN EVERYTHING. An unpinned `pip install onnxruntime` is exactly what
# confounded the original experiment.
# Replace the numpy/opencv/psutil pins with the versions `pip freeze`
# reports on the bare-metal host, so the two environments match exactly.
RUN pip install --no-cache-dir \
        onnxruntime==1.29.0 \
        numpy==2.1.3 \
        opencv-python-headless==4.10.0.84 \
        psutil==6.1.0 \
        requests==2.32.3 \
        smbus2==0.5.0

WORKDIR /app
COPY classification.py provenance.py basil_mobilenet.onnx ./
CMD ["python3", "classification.py"]
