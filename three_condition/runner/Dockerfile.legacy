# Condition C — the ORIGINAL container, now made reproducible.
#
# NOTE: the original image itself is gone (the SD card was reimaged), so this is
# a RECONSTRUCTION of it from the determined pins, not the artefact that ran in
# the first round. The manuscript must say so.
# Identical to the image used in the measured runs, except that the versions
# pip resolved at build time are written down explicitly.
#
# The onnxruntime pin is DETERMINED, not guessed. The original Dockerfile
# installed `onnxruntime` with no constraint, so pip resolved the newest
# release carrying a wheel compatible with this base image. For
# python:3.9-slim-bullseye on linux/arm64 that wheel must be tagged cp39 and
# aarch64, and the last onnxruntime release publishing one is 1.19.2
# (onnxruntime-1.19.2-cp39-cp39-manylinux_2_27_aarch64.manylinux_2_28_aarch64.whl,
# uploaded 2024-09-04). No later release publishes a cp39 aarch64 wheel at all,
# and the manylinux_2_27 floor is satisfied by Debian 11's glibc 2.31.
# Exactly one release therefore fits, and it is pinned below.
#
# For comparison, the bare-metal runs used onnxruntime 1.29.0, released
# 2026-08-17 — eighteen releases and roughly 23 months later.
FROM python:3.9-slim-bullseye

# libglib2.0-0 is in the original Dockerfile but is NOT installed here: Debian
# 11 reached end of life and that package has been removed from
# bullseye-security, so the build 404s. opencv-python-headless is built for
# environments without a GUI stack and does not need it; the rehearsal run
# verifies `import cv2` still works. This is the one respect in which the
# reconstruction departs from the original image, and the manuscript says so.
RUN apt-get update && apt-get install -y --no-install-recommends \
        procps \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
        onnxruntime==1.19.2 \
        numpy==1.26.4 \
        opencv-python-headless==4.10.0.84 \
        psutil==6.1.0 \
        requests==2.32.3 \
        smbus2==0.5.0

WORKDIR /app
COPY profile_run.py provenance.py basil_mobilenet.onnx ./
CMD ["python3", "profile_run.py", "--condition", "legacy"]
